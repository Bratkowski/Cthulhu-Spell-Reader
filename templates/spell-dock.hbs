<div id="coc7-spell-dock" role="region" aria-label="Cthulhu Spell Reader">
  <header class="dock-header">
    <div class="hdr-left">
      <div class="caster-info">
        <div class="caster-name">{{casterName}}</div>
        <div class="stats" id="coc7-spell-dock-stats"></div>
      </div>
      {{#if isGM}}<span class="caster-badge">GM mode</span>{{/if}}
    </div>
    <div class="hdr-mid">
      <input id="coc7-spell-dock-search" type="search" placeholder="Szukaj zaklęcia…" aria-label="Szukaj zaklęcia" />
    </div>
    <div class="hdr-right">
      <button class="btn" data-action="clear" type="button" title="Wyczyść wyszukiwanie" aria-label="Wyczyść wyszukiwanie">⌫</button>
      <button class="btn" data-action="toggle" type="button" title="Zwiń/Rozwiń" aria-label="Zwiń/Rozwiń" aria-expanded="true">⇵</button>
      <button class="btn" data-action="close" type="button" title="Zamknij" aria-label="Zamknij">X</button>
    </div>
  </header>
  <div class="dock-carousel">
    <button class="car-arrow" data-action="left" type="button" aria-label="Poprzednie zaklęcia">◀</button>
    <div class="car-track" id="coc7-spell-dock-track" aria-label="Zaklęcia"></div>
    <button class="car-arrow" data-action="right" type="button" aria-label="Następne zaklęcia">▶</button>
  </div>
  <p class="empty-spells" hidden>Brak zaklęć pasujących do wyszukiwania.</p>
  <div class="dock-details" id="coc7-spell-dock-preview"></div>
  <aside class="spell-flyout" id="coc7-spell-dock-flyout" aria-label="Podgląd zaklęcia" hidden>
    <button class="btn fly-close" data-action="close-flyout" type="button" aria-label="Zamknij podgląd">X</button>
    <div class="fly-preview"></div>
  </aside>
</div>
